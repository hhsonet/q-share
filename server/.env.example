# --- Server ---
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
# Set true when behind nginx/Caddy so rate limiting sees real client IPs
TRUST_PROXY=false
# Public site URL used to build share links (leave empty to use the browser origin)
PUBLIC_URL=
# Only needed when the frontend is served from a different origin (dev: http://localhost:5173)
CORS_ORIGIN=

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quickshare
DB_PASSWORD=change-me
DB_NAME=quickshare

# --- Storage (keep OUTSIDE any public web root) ---
STORAGE_DIR=./storage

# --- Limits ---
# Maximum size of a single file, in MB
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_REQUEST=10
# Comma-separated allowlist. Executables/scripts/html/svg are always blocked.
# ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,docx,xlsx,pptx,txt,csv,zip,mp3,mp4

# --- Expiration ---
# Hours until an upload expires. 0 = never expire.
FILE_EXPIRY_HOURS=168
# How often the in-process cleanup runs. 0 = disabled (use cron: npm run cleanup)
CLEANUP_INTERVAL_MINUTES=60

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=60
